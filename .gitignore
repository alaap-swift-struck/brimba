# Machine output — never committed (unanchored: applies in every folder)
node_modules/
.next/
out/

# Local secrets + OS noise
.env*
.DS_Store
*.log
*.tsbuildinfo

# Worker local secrets — keep out of git
.dev.vars
.wrangler/
.dev-state/
.dev.vars

# Generated by the architecture_blueprint skill — regenerable, not source
/architecture-blueprint.html

# Per-workstream working notes — local to whoever is building, never forked
# into a new app (the new-app skill clones this repo).
.session-notes/

# Claude Code skills live globally in ~/.claude/skills/ — never vendored here
/skills/

# Playwright writes screenshots and traces here on a failing e2e run. They are
# build output, not source — and an untracked binary here fails the fork sweep.
web/test-results/
web/playwright-report/
